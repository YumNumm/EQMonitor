FLAVOR=dev
REST_API_URL=https://dev.v2.api.eqmonitor.app
WS_API_URL=wss://example.com/ws #CHANGE THIS
API_AUTHORIZATION=
APP_ID_SUFFIX=.dev
APP_NAME="[dev] EQMonitor"
# Native認証は全項目がConsole登録値と一致するときだけ有効になる。
# 未設定のままでは認証UIを開かずconfiguration errorとしてfail closedする。
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REVERSED_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
APPLE_SERVICE_ID=
# Console / plist / provisioning / Android署名設定の一致を実機確認後だけtrueにする。
IS_NATIVE_SOCIAL_AUTH_ENABLED=false
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
APP_ICON=AppIcon-prod
# EQMonitor Pro を有効化するか。未指定時は false（Pro 機能・課金導線を無効化）。
# Pro を再開する場合は true を指定する。
IS_PRO_FEATURES_ENABLED=false
