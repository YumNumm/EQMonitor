{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"outDir": "./dist",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"exclude": ["node_modules"],
	"include": ["src/**/*"]
}
