#!/usr/bin/env bash

set -euo pipefail

expected_revision=4dacd3fc91d96262a33e5c598e17d816f0b35641
tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$tool_dir/../.." && pwd -P)"
sdk_dir="$repo_root/.flutter-scene-sdk"
sdk_tool="${1:-}"

case "$sdk_tool" in
  flutter|dart) ;;
  *)
    echo "unsupported pinned Flutter tool: $sdk_tool" >&2
    exit 64
    ;;
esac

if [[ "$sdk_tool" == flutter ]]; then
  for argument in "${@:2}"; do
    case "$argument" in
      upgrade|downgrade|channel)
        echo "pinned Flutter runner refuses self-update command: flutter $argument" >&2
        exit 64
        ;;
    esac
  done
fi

exec "$tool_dir/flutter_sdk_guard.sh" \
  "$sdk_dir" \
  "$expected_revision" \
  "$sdk_tool" \
  "${@:2}"
