{
	"dart.runPubGetOnPubspecChanges": "never",
	"dart.flutterSdkPath": "~/.local/share/mise/installs/flutter/3.35.3-stable",
	// MEMO(YumNumm): miseの自動構成で`.vscode/mise-tools`配下にシンボリックリンクを作成し、それをツールのパスとして利用する機能を有効にします
	// 2025/05/02検証時では、bunのみ正常に設定され、それ以外のツールでは絶対パスで設定されました
	"mise.configureExtensionsUseSymLinks": true,
	// MEMO(YumNumm): miseの自動構成では、以下の拡張に関するパスを絶対パスで設定するため無効化
	"mise.configureExtensionsAutomatically": false,
	"files.watcherExclude": {
		"*.geojson": true,
		"**/DerivedData": true
	},
	"files.readonlyInclude": {
		"**/*.lock": true
	},
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
		"*.dart": "${capture}.g.dart, ${capture}.freezed.dart, ${capture}.viewmodel.dart"
	},
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.associations": {
		"./.vscode/*.json": "jsonc"
	},
	"editor.formatOnSave": true,
	"[typescript][javascript][json][jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	}
}
